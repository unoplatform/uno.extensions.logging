<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-ios;net10.0-tvos</TargetFrameworks>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<NoNFloatUsing>true</NoNFloatUsing>

		<NoWarn>$(NoWarn);NU5128</NoWarn>

		<!-- Matches the Uno Platform 7.0 floor (Uno.Common.iOS.targets). -->
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-tvos'">14.2</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="1.1.1" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\..\build\_._" PackagePath="lib\net10.0-macos15.0" Pack="true" Visible="False" />
		<Content Include="..\..\build\_._" PackagePath="lib\net10.0-android21.0" Pack="true" Visible="False" />
	</ItemGroup>
</Project>
